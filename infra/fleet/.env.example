# Copy to infra/fleet/.env on the host that runs the fleet. Host settings only: NO secrets
# here. Secrets live in FLEET_SECRETS_DIR (see README.md, `mise run fleet:secrets`).

# Secret files (mode 600, directory 700). Default: ~/.config/cluetooth-fleet/secrets
# FLEET_SECRETS_DIR=

# REQUIRED. Gitea's data/ and config/ on the host (no default: a wrong path would start an
# empty Gitea). simi: /data/services/wirelesswiki/gitea
GITEA_HOST_DIR=
# The uid:gid that owns GITEA_HOST_DIR/data (Gitea runs as it). simi: 1000:1000
# GITEA_UID=1000
# GITEA_GID=1000
# GITEA_DOMAIN=git.wirelesswiki.org

# The Gitea bot keyproxy acts as, and the agents' repo.
# GITEA_BOT_USER=wiki-bot
# GITEA_REPO=y2wei/wirelesswiki

# The data stack's network, for cluetooth-db (infra/data, project newcluetooth).
# SCANDB_NETWORK=newcluetooth_default

# Research agent. simi: PASEO_RELAY_ENABLED=true (pairs the owner's Paseo app).
# PASEO_RELAY_ENABLED=false
# PASEO_HOST_PORT=6768
# AGENT_MEM_LIMIT=40g
# RESEARCH_AGENT_IMAGE=research-agent:dev

# keyproxy account-protection limits; each can be switched off. WIGLE_DAILY_BUDGET should be
# the account's real daily limit; the proxy stops WIGLE_RESERVE calls short of it.
# WIGLE_DAILY_BUDGET_ENABLED=true
# WIGLE_DAILY_BUDGET=100
# WIGLE_RESERVE=10
# ANDROZOO_RATE_LIMIT_ENABLED=true
# ANDROZOO_MIN_INTERVAL_SECONDS=10
