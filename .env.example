# Copy this file to .env on the host running docker compose.
# Do not commit real .env files.

# Compose project name controls generated network/volume names.
COMPOSE_PROJECT_NAME=newcluetooth

# Host port exposed for Postgres.
POSTGRES_PORT=5432

# Postgres data source.
# Leave as postgres-data to use Docker's named volume declared in compose.yaml.
# Set to an absolute host path in prod, for example /srv/cluetooth/postgres.
CLUETOOTH_POSTGRES_DATA_SOURCE=postgres-data

# GCS source for encrypted scan blobs.
CLUETOOTH_BUCKET=cluetooth-1da02.firebasestorage.app
CLUETOOTH_PREFIX=scans/

# Host path used as the encrypted blob mirror/cache for sync containers.
CLUETOOTH_HOST_MIRROR_DIR=./downloads

# Sync worker settings.
CLUETOOTH_DOWNLOAD_WORKERS=4
CLUETOOTH_INGEST_WORKERS=2
CLUETOOTH_QUEUE_SIZE=0
CLUETOOTH_POLL_INTERVAL_SECONDS=30

